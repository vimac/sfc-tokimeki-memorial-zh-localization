# ROM images and emulator state. Binaries never go in the tree; the authoritative md5s
# and the one-command rebuild are in docs/RELEASE_zh.md.
*.sfc
*.smc
*.srm
*.ips
*.bps
*.xdelta

# Derived dumps of the Japanese ROM. Regenerate with tools/extract_all.py (out/script),
# tools/dump_text.py (out/text) and tools/extract_font.py (out/font).
out/

# 18 MB of third-party fan-translation material, read-only input, not ours to version.
reference/

# Extracted Japanese script queue for future batches; written by tools/translate_batch.py.
translations/pending.json

# Render evidence regenerated by tools/prologue_shots.py from an emulator walk.
# index.txt (the transcript) IS tracked; docs/evidence_2026-09-18_jis/ (the original
# 乱码 screenshots that motivated the rebuild) is tracked too -- it cannot be recreated.
docs/prologue_zh/*.png
docs/research/render_rom_prologue_zh/

__pycache__/
*.pyc
.DS_Store
.zcode/
